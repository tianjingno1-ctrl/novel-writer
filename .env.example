# 复制本文件为 .env，填入你的 Key（不要加 Bearer 前缀）
# 文件名就是 .env，放在 novel_writer 文件夹里，和 main.py 同级

KIE_API_KEY=在这里粘贴kie的key
DEEPSEEK_API_KEY=在这里粘贴deepseek的key

# 可选：辅助任务提供商（默认均为 deepseek）
# NOVEL_SUMMARY_PROVIDER=deepseek
# NOVEL_CHECK_PROVIDER=deepseek
# NOVEL_OUTLINE_PROVIDER=deepseek

# 可选：Web API 最小鉴权（设置后浏览器须在首次请求时输入相同令牌）
# NOVEL_WEB_TOKEN=自行设置一串随机字符
