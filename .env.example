# 复制本文件为 .env，填入你的 Key（不要加 Bearer 前缀）
# 文件名就是 .env，放在 novel_writer 文件夹里，和 main.py 同级

KIE_API_KEY=在这里粘贴kie的key
DEEPSEEK_API_KEY=在这里粘贴deepseek的key
# DeepSeek 模型 ID（默认 deepseek-v4-pro；省钱可改 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-pro

# 可选：辅助任务提供商（默认均为 deepseek）
# NOVEL_SUMMARY_PROVIDER=deepseek
# NOVEL_CHECK_PROVIDER=deepseek
# NOVEL_OUTLINE_PROVIDER=deepseek
# NOVEL_MAINTAIN_PROVIDER=deepseek
# NOVEL_QUALITY_PROVIDER=deepseek

# 可选：Web API 最小鉴权（设置后浏览器须在首次请求时输入相同令牌）
# NOVEL_WEB_TOKEN=自行设置一串随机字符

# 可选：每次 API 请求记录上下文体积到 data/context_log.jsonl（默认开启）
# NOVEL_CONTEXT_LOG=0

# 可选：写书 / 自由聊各自保留最近几轮对话（0=不截断）；Web ⚙️ 也可改并写入 runtime.json
# NOVEL_CONTEXT_TURNS=10
# NOVEL_FREE_CHAT_TURNS=20

# 可选：单次回复输出 token 上限（默认写书 8192，自由聊 64000 超长）
# 自由聊用 DeepSeek 若报 max_tokens 错误，可改为 8192 或 16384
# NOVEL_MAX_TOKENS=8192
# NOVEL_FREE_CHAT_MAX_TOKENS=64000
