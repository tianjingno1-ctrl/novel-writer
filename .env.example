# 复制本文件为 .env，填入你的 Key（不要加 Bearer 前缀）
# 文件名就是 .env，放在 novel_writer 文件夹里，和 main.py 同级

KIE_API_KEY=在这里粘贴kie的key
DEEPSEEK_API_KEY=在这里粘贴deepseek的key

# 默认全部走 DeepSeek（省钱）；写书恢复 Claude 时取消下行注释
NOVEL_PROVIDER=deepseek
# NOVEL_SUMMARY_PROVIDER=deepseek
# NOVEL_CHECK_PROVIDER=deepseek
# NOVEL_OUTLINE_PROVIDER=deepseek
# NOVEL_MAINTAIN_PROVIDER=deepseek
# NOVEL_QUALITY_PROVIDER=deepseek
# DeepSeek 模型 ID（默认 deepseek-v4-pro；省钱可改 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-pro

# 可选：辅助任务提供商（未设置时 config.py 默认均为 deepseek）
# NOVEL_SUMMARY_PROVIDER=deepseek
# NOVEL_CHECK_PROVIDER=deepseek
# NOVEL_OUTLINE_PROVIDER=deepseek
# NOVEL_MAINTAIN_PROVIDER=deepseek
# NOVEL_QUALITY_PROVIDER=deepseek

# 可选：Web API 最小鉴权（设置后浏览器须在首次请求时输入相同令牌）
# NOVEL_WEB_TOKEN=自行设置一串随机字符

# 可选：每次 API 请求记录上下文体积到 data/context_log.jsonl（默认开启）
# NOVEL_CONTEXT_LOG=0

# 运行时 Bug 日志（双目录：dev 写 logs/dev/，write 写 logs/write/）
# NOVEL_RUNTIME_ENV=dev|write   # 未设时按文件夹名自动识别（*_write → write）
# NOVEL_RUNTIME_LOG=0           # 关闭
# NOVEL_RUNTIME_LOG_DEBUG=1     # 写作环境也记录 debug 级
# NOVEL_WEB_PORT=8765           # 开发目录可用 8766（见 启动web_开发.bat）

# 可选：写书保留最近几轮对话（0=不截断）；Web ⚙️ 也可改并写入 runtime.json
# NOVEL_CONTEXT_TURNS=10

# 可选：单次回复输出 token 上限（默认 8192）
# NOVEL_MAX_TOKENS=8192
# 预填章规划 JSON 较长，可单独提高（默认 16384）
# NOVEL_PREFILL_PLAN_MAX_TOKENS=16384

# 可选：整批档案同步多章正文拼接上限
# NOVEL_BULK_ARCHIVE_INPUT_MAX_CHARS=36000
# NOVEL_BULK_ARCHIVE_CHAPTER_MAX_CHARS=12000
